rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'jackzcruz@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isMasterAdmin();
      allow create, update: if (isOwner(userId) && request.resource.data.role != 'admin') || isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }
  }
}
